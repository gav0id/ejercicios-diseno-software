public interface SistemaRespuesta {
    void responder(String ubicacion, String nivelHumo);
}

//-----

public class CentralAlarmas implements SistemaRespuesta {
    @Override
    public void responder(String ubicacion, String nivelHumo) {
        System.out.println("Central Alarmas - sirena activada en " + ubicacion + " (nivel: " + nivelHumo + ")");
    }
}

//-----

public class RociadoresAutomaticos implements SistemaRespuesta {
    @Override
    public void responder(String ubicacion, String nivelHumo) {
        System.out.println("Rociadores - descargando agua en " + ubicacion);
    }
}

