public record Evento(String tipo, String payload) {}

//-----

public interface SuscriptorEvento {
    void procesar(Evento evento);
}

//-----

public class ServicioBienvenida implements SuscriptorEvento {
    @Override
    public void procesar(Evento evento) {
        System.out.println("Servicio Bienvenida - correo enviado para " + evento.payload());
    }
}

//-----

public class ServicioFacturacion implements SuscriptorEvento {
    @Override
    public void procesar(Evento evento) {
        System.out.println("Servicio Facturacion - comprobante generado para " + evento.payload());
    }
}

//-----

public class ServicioAnalitica implements SuscriptorEvento {
    @Override
    public void procesar(Evento evento) {
        if (evento.payload().contains("ERROR")) {
            throw new RuntimeException("Fallo de conexion con base analitica");
        }
        System.out.println("Servicio Analitica - metrica registrada [" + evento.tipo() + "] " + evento.payload());
    }
}

//-----

import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.CopyOnWriteArrayList;

public class BusEventos {

    private final ConcurrentHashMap<String, CopyOnWriteArrayList<SuscriptorEvento>> rutas = new ConcurrentHashMap<>();

    public void suscribir(String tipoEvento, SuscriptorEvento suscriptor) {
        if (tipoEvento == null || suscriptor == null) return;
        rutas.computeIfAbsent(tipoEvento.trim().toUpperCase(), k -> new CopyOnWriteArrayList<>())
             .addIfAbsent(suscriptor);
    }

    public void desuscribir(String tipoEvento, SuscriptorEvento suscriptor) {
        if (tipoEvento == null || suscriptor == null) return;
        CopyOnWriteArrayList<SuscriptorEvento> lista = rutas.get(tipoEvento.trim().toUpperCase());
        if (lista != null) lista.remove(suscriptor);
    }

    public void publicar(Evento evento) {
        if (evento == null || evento.tipo() == null) return;
        CopyOnWriteArrayList<SuscriptorEvento> lista = rutas.get(evento.tipo().trim().toUpperCase());
        if (lista == null) return;

        for (SuscriptorEvento s : lista) {
            try {
                s.procesar(evento);
            } catch (Exception e) {
                System.out.println("BusEventos - error en suscriptor para " + evento.tipo() + " - " + e.getMessage());
            }
        }
    }
}

//-----

public class Main {
    public static void main(String[] args) {
        BusEventos bus = new BusEventos();
        SuscriptorEvento bienvenida = new ServicioBienvenida();
        SuscriptorEvento facturacion = new ServicioFacturacion();
        SuscriptorEvento analitica = new ServicioAnalitica();

        bus.suscribir("UsuarioRegistrado", analitica);
        bus.suscribir("UsuarioRegistrado", bienvenida);
        bus.suscribir("PagoAprobado", facturacion);
        bus.suscribir("PagoAprobado", analitica);

        bus.publicar(new Evento("UsuarioRegistrado", "Kouichi Sakakibara (ERROR_SYNC)"));
        bus.publicar(new Evento("PagoAprobado", "Orden #8042 - $65000"));
    }
}
