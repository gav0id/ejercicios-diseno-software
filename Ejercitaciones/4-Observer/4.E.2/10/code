public interface EntidadRegulatoria {
    String getNombre();
    void auditar(String cuentaCorporativa, String riesgoAnterior, String riesgoNuevo);
}

//-----

import java.util.List;

public record AuditoriaCumplimiento(
    String cuentaCorporativa,
    String riesgoAnterior,
    String riesgoNuevo,
    List<String> exitosas,
    List<String> incidencias
) {
    public AuditoriaCumplimiento {
        exitosas = List.copyOf(exitosas);
        incidencias = List.copyOf(incidencias);
    }
}

//-----

public class PrevencionLavado implements EntidadRegulatoria {
    @Override
    public String getNombre() { return "PrevencionLavado"; }

    @Override
    public void auditar(String cuentaCorporativa, String riesgoAnterior, String riesgoNuevo) {
        if ("CRITICO".equalsIgnoreCase(riesgoNuevo)) {
            throw new IllegalStateException("Error al consultar base global AML");
        }
        System.out.println("Prevencion Lavado - verificacion AML aprobada para " + cuentaCorporativa + " (" + riesgoNuevo + ")");
    }
}

