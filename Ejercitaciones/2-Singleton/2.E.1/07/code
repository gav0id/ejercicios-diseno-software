public class Main {

    public static void main(String[] args) {
        ColaImpresion a = ColaImpresion.obtenerInstancia();
        ColaImpresion b = ColaImpresion.obtenerInstancia();
        System.out.println("Misma instancia: " + (a == b));

        TerminalVentas ventas = new TerminalVentas();
        TerminalAdministracion admin = new TerminalAdministracion();

        ventas.enviar("factura01.pdf", "Ana");
        admin.enviar("contrato.docx", "Luis");
        ventas.enviar("informe.pdf", "Ana");

        a.mostrarCola();
        a.imprimirTodos();
    }
}
