public class Documento {

    private final String nombreArchivo;
    private final String autor;

    public Documento(String nombreArchivo, String autor) {
        this.nombreArchivo = nombreArchivo;
        this.autor = autor;
    }

    public String getNombreArchivo() {
        return nombreArchivo;
    }

    public String getAutor() {
        return autor;
    }

    @Override
    public String toString() {
        return nombreArchivo + " (" + autor + ")";
    }
}

//-----

public class TerminalVentas {

    public void enviar(String nombreArchivo, String autor) {
        ColaImpresion cola = ColaImpresion.obtenerInstancia();
        String respuesta = cola.encolar(new Documento(nombreArchivo, autor));
        System.out.println("Ventas -> " + respuesta);
    }
}

//-----

public class TerminalAdministracion {

    public void enviar(String nombreArchivo, String autor) {
        ColaImpresion cola = ColaImpresion.obtenerInstancia();
        String respuesta = cola.encolar(new Documento(nombreArchivo, autor));
        System.out.println("Administracion -> " + respuesta);
    }
}

