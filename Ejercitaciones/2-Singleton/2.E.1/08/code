public class ServicioSuscripciones {

    private final PasarelaPago pasarela;

    public ServicioSuscripciones(PasarelaPago pasarela) {
        this.pasarela = pasarela;
    }

    public void renovar(String cliente, double monto) {
        System.out.println("Suscripciones -> " + pasarela.procesarPago(cliente, monto));
    }
}

