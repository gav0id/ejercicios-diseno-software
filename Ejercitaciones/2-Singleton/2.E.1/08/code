public class Main {

    public static void main(String[] args) {
        PasarelaPagoReal real = PasarelaPagoReal.obtenerInstancia();
        ServicioCheckout checkout = new ServicioCheckout(real);
        ServicioSuscripciones suscripciones = new ServicioSuscripciones(real);

        checkout.cobrar("Ana", 1500);
        suscripciones.renovar("Luis", 800);
        checkout.cobrar("", 300);
        real.mostrarHistorial();

        PasarelaPagoFalsa falsa = new PasarelaPagoFalsa();
        new ServicioCheckout(falsa).cobrar("Prueba", 100);
        System.out.println("Llamadas a la falsa: " + falsa.cantidadLlamadas());
    }
}
