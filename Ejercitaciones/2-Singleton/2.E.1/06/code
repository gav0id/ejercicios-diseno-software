public class Main {

    public static void main(String[] args) {
        GestorTemas a = GestorTemas.obtenerInstancia();
        GestorTemas b = GestorTemas.obtenerInstancia();
        System.out.println("Misma instancia: " + (a == b));

        VistaPrincipal principal = new VistaPrincipal();
        VistaConfiguracion config = new VistaConfiguracion();

        principal.dibujar();
        config.dibujar();

        config.elegirTema(Tema.OSCURO);
        principal.dibujar();
        config.dibujar();

        config.elegirTema(Tema.OSCURO);
        config.elegirTema(null);

        config.personalizarColor("boton", "#FF0000");
        config.personalizarColor("boton", "rojo");
        config.personalizarColor("borde", "#FF0000");

        principal.presionarBotonTema();
        principal.dibujar();
        principal.presionarBotonTema();
        principal.dibujar();

        a.alternarTema();
        a.alternarTema();
        a.alternarTema();
        a.alternarTema();

        a.mostrarHistorial();
    }
}
