public class Main {

    public static void main(String[] args) {
        ServicioCache a = ServicioCache.obtenerInstancia();
        ServicioCache b = ServicioCache.obtenerInstancia();
        System.out.println("Misma instancia: " + (a == b));
        System.out.println("Capacidad inicial: " + a.capacidad());

        ModuloPerfiles perfiles = new ModuloPerfiles();
        ModuloSesiones sesiones = new ModuloSesiones();

        perfiles.guardarPerfil("u1", "Ana - Buenos Aires");
        perfiles.guardarPerfil("u2", "Luis - Mendoza");
        perfiles.guardarPerfil("u3", "Sofia - Cordoba");
        System.out.println("Capacidad: " + a.capacidad() + ", elementos: " + a.cantidadElementos());

        perfiles.guardarPerfil("u4", "Marta - Salta");
        System.out.println("Capacidad: " + a.capacidad() + ", elementos: " + a.cantidadElementos());

        sesiones.iniciarSesion("u2");
        perfiles.guardarPerfil("u2", "Luis - San Rafael");
        sesiones.iniciarSesion("u2");

        perfiles.eliminarPerfil("u1");
        sesiones.iniciarSesion("u1");

        a.mostrarContenido();
    }
}
