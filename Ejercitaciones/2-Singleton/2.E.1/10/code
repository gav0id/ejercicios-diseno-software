public class ModuloTransferencias {

    public void transferir(String sesion, String operador, double monto) {
        AuditorSeguridad.obtenerInstancia()
                .registrar(sesion, operador, "Transferencia de $" + monto);
    }
}

//-----

public class ModuloPrivilegios {

    public void otorgarAdmin(String sesion, String operador, String destino) {
        AuditorSeguridad.obtenerInstancia()
                .registrar(sesion, operador, "Otorga privilegios de administrador a " + destino);
    }
}

