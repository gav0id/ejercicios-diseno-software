public class Main {

    public static void main(String[] args) {
        AuditorSeguridad a = AuditorSeguridad.obtenerInstancia();
        AuditorSeguridad b = AuditorSeguridad.obtenerInstancia();
        System.out.println("Misma instancia: " + (a == b));

        new ModuloTransferencias().transferir("S-01", "ana", 5000);
        new ModuloPrivilegios().otorgarAdmin("S-02", "luis", "marta");
        new ModuloTransferencias().transferir("S-01", "ana", 120);

        System.out.println("Total de registros: " + a.cantidadRegistros());
        for (RegistroAuditoria r : a.obtenerTraza()) {
            System.out.println(r);
        }
    }
}



