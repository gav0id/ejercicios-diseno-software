import java.time.LocalDateTime;

public final class AuditorSeguridad {

    private static volatile AuditorSeguridad instancia;

    private final Object candado = new Object();

    private RegistroAuditoria[] registros;
    private int cantidad;
    private long ultimaSecuencia;

    private AuditorSeguridad() {
        if (instancia != null) {
            throw new IllegalStateException("Ya existe un auditor");
        }
        registros = new RegistroAuditoria[2];
        cantidad = 0;
        ultimaSecuencia = 0;
    }

    public static AuditorSeguridad obtenerInstancia() {
        if (instancia == null) {
            synchronized (AuditorSeguridad.class) {
                if (instancia == null) {
                    instancia = new AuditorSeguridad();
                }
            }
        }
        return instancia;
    }

    @Override
    protected Object clone() throws CloneNotSupportedException {
        throw new CloneNotSupportedException("El auditor no se puede duplicar");
    }

    public long registrar(String sesion, String operador, String accion) {
        if (sesion == null || sesion.isEmpty() || operador == null || operador.isEmpty()
                || accion == null || accion.isEmpty()) {
            return -1;
        }
        synchronized (candado) {
            if (cantidad == registros.length) {
                agrandar();
            }
            ultimaSecuencia++;
            registros[cantidad] = new RegistroAuditoria(
                    ultimaSecuencia, LocalDateTime.now(), sesion, operador, accion);
            cantidad++;
            return ultimaSecuencia;
        }
    }

    private void agrandar() {
        RegistroAuditoria[] nuevo = new RegistroAuditoria[registros.length * 2];
        for (int i = 0; i < cantidad; i++) {
            nuevo[i] = registros[i];
        }
        registros = nuevo;
    }

    public int cantidadRegistros() {
        synchronized (candado) {
            return cantidad;
        }
    }

    public RegistroAuditoria[] obtenerTraza() {
        synchronized (candado) {
            RegistroAuditoria[] copia = new RegistroAuditoria[cantidad];
            for (int i = 0; i < cantidad; i++) {
                copia[i] = registros[i];
            }
            return copia;
        }
    }
}

