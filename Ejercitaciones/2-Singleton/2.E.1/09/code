import java.util.Locale;

public class ColectorMetricas {

    private static final int MAX_METRICAS = 4;
    private static final int MAX_ARCHIVO = 3;

    private static volatile ColectorMetricas instancia;

    private final Object candado = new Object();

    private String[] nombresContadores;
    private long[] valoresContadores;
    private int cantidadContadores;

    private String[] nombresLatencias;
    private long[] cantidadMediciones;
    private long[] sumaLatencias;
    private long[] maximoLatencias;
    private int cantidadLatencias;

    private String[] archivo;
    private int cantidadArchivo;

    private ColectorMetricas() {
        nombresContadores = new String[MAX_METRICAS];
        valoresContadores = new long[MAX_METRICAS];
        nombresLatencias = new String[MAX_METRICAS];
        cantidadMediciones = new long[MAX_METRICAS];
        sumaLatencias = new long[MAX_METRICAS];
        maximoLatencias = new long[MAX_METRICAS];
        archivo = new String[MAX_ARCHIVO];
    }

    public static ColectorMetricas obtenerInstancia() {
        if (instancia == null) {
            synchronized (ColectorMetricas.class) {
                if (instancia == null) {
                    instancia = new ColectorMetricas();
                }
            }
        }
        return instancia;
    }

    private int totalMetricas() {
        return cantidadContadores + cantidadLatencias;
    }

    private int buscarContador(String nombre) {
        for (int i = 0; i < cantidadContadores; i++) {
            if (nombresContadores[i].equals(nombre)) {
                return i;
            }
        }
        return -1;
    }

    private int buscarLatencia(String nombre) {
        for (int i = 0; i < cantidadLatencias; i++) {
            if (nombresLatencias[i].equals(nombre)) {
                return i;
            }
        }
        return -1;
    }

    public void incrementar(String nombre) {
        if (nombre == null) {
            return;
        }
        synchronized (candado) {
            int pos = buscarContador(nombre);
            if (pos == -1) {
                if (totalMetricas() == MAX_METRICAS) {
                    archivarYLimpiar();
                }
                pos = cantidadContadores;
                nombresContadores[pos] = nombre;
                valoresContadores[pos] = 0;
                cantidadContadores++;
            }
            valoresContadores[pos]++;
        }
    }

    public void registrarLatencia(String nombre, long ms) {
        if (nombre == null || ms < 0) {
            return;
        }
        synchronized (candado) {
            int pos = buscarLatencia(nombre);
            if (pos == -1) {
                if (totalMetricas() == MAX_METRICAS) {
                    archivarYLimpiar();
                }
                pos = cantidadLatencias;
                nombresLatencias[pos] = nombre;
                cantidadMediciones[pos] = 0;
                sumaLatencias[pos] = 0;
                maximoLatencias[pos] = 0;
                cantidadLatencias++;
            }
            cantidadMediciones[pos]++;
            sumaLatencias[pos] += ms;
            if (ms > maximoLatencias[pos]) {
                maximoLatencias[pos] = ms;
            }
        }
    }

    private void archivarYLimpiar() {
        guardarEnArchivo(construirResumen());
        cantidadContadores = 0;
        cantidadLatencias = 0;
    }

    private void guardarEnArchivo(String resumen) {
        if (cantidadArchivo == archivo.length) {
            for (int i = 1; i < archivo.length; i++) {
                archivo[i - 1] = archivo[i];
            }
            cantidadArchivo--;
        }
        archivo[cantidadArchivo] = resumen;
        cantidadArchivo++;
    }

    private String construirResumen() {
        StringBuilder sb = new StringBuilder();
        sb.append("Contadores:\n");
        for (int i = 0; i < cantidadContadores; i++) {
            sb.append("  ").append(nombresContadores[i])
              .append(" = ").append(valoresContadores[i]).append("\n");
        }
        sb.append("Latencias:\n");
        for (int i = 0; i < cantidadLatencias; i++) {
            double promedio = (double) sumaLatencias[i] / cantidadMediciones[i];
            sb.append("  ").append(nombresLatencias[i])
              .append(": cantidad=").append(cantidadMediciones[i])
              .append(", promedio=").append(String.format(Locale.US, "%.1f", promedio))
              .append(" ms, maximo=").append(maximoLatencias[i]).append(" ms\n");
        }
        return sb.toString();
    }

    public String exportarResumen() {
        synchronized (candado) {
            StringBuilder sb = new StringBuilder("=== Resumen de metricas ===\n");
            for (int i = 0; i < cantidadArchivo; i++) {
                sb.append("--- Archivado ").append(i + 1).append(" ---\n").append(archivo[i]);
            }
            if (cantidadArchivo > 0) {
                sb.append("--- Actual ---\n");
            }
            sb.append(construirResumen());
            return sb.toString();
        }
    }
}

//-----

public class InterceptorRed {

    public void procesarPeticion(long ms) {
        ColectorMetricas colector = ColectorMetricas.obtenerInstancia();
        colector.incrementar("peticiones");
        colector.registrarLatencia("red", ms);
    }
}

//-----

public class ModuloBaseDatos {

    public void consultar(long ms) {
        ColectorMetricas colector = ColectorMetricas.obtenerInstancia();
        colector.incrementar("consultas");
        colector.registrarLatencia("consulta_bd", ms);
    }
}

