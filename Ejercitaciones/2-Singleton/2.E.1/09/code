public class Main {

    public static void main(String[] args) {
        ColectorMetricas a = ColectorMetricas.obtenerInstancia();
        ColectorMetricas b = ColectorMetricas.obtenerInstancia();
        System.out.println("Misma instancia: " + (a == b));

        InterceptorRed red = new InterceptorRed();
        ModuloBaseDatos bd = new ModuloBaseDatos();

        red.procesarPeticion(120);
        red.procesarPeticion(80);
        red.procesarPeticion(200);
        bd.consultar(50);

        System.out.print(a.exportarResumen());
    }
}
