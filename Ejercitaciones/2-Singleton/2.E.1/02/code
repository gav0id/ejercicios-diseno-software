public class ModuloPedidos {

    public void listarPedidos() {
        GestorConexion gestor = GestorConexion.obtenerInstancia();
        String resultado = gestor.ejecutarConsulta("SELECT * FROM pedidos");
        System.out.println("Pedidos -> " + resultado);
    }

    public void registrarPedido(String producto) {
        GestorConexion gestor = GestorConexion.obtenerInstancia();
        int filas = gestor.ejecutarActualizacion("INSERT INTO pedidos VALUES ('" + producto + "')");
        System.out.println("Pedidos -> filas afectadas: " + filas);
    }
}

