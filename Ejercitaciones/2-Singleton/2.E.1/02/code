public class Main {

    public static void main(String[] args) {
        GestorConexion a = GestorConexion.obtenerInstancia();
        GestorConexion b = GestorConexion.obtenerInstancia();
        System.out.println("Misma instancia: " + (a == b));

        ModuloClientes clientes = new ModuloClientes();
        ModuloPedidos pedidos = new ModuloPedidos();

        clientes.listarClientes();

        a.conectar();
        clientes.listarClientes();
        clientes.agregarCliente("Ana");
        pedidos.listarPedidos();
        pedidos.registrarPedido("Teclado");
        pedidos.registrarPedido("Mouse");
        pedidos.registrarPedido("Monitor");
        clientes.agregarCliente("Luis");

        a.mostrarHistorial();

        clientes.cerrarConexion();
        pedidos.listarPedidos();
    }
}
