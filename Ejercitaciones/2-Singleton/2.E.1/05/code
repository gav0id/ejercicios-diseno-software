public class Main {

    public static void main(String[] args) {
        ControladorHardware a = ControladorHardware.obtenerInstancia();
        ControladorHardware b = ControladorHardware.obtenerInstancia();
        System.out.println("Misma instancia: " + (a == b));

        try {
            a.clone();
        } catch (CloneNotSupportedException e) {
            System.out.println("Duplicacion bloqueada: " + e.getMessage());
        }

        ModuloBrazo brazo = new ModuloBrazo();
        ModuloSensores sensores = new ModuloSensores();

        sensores.consultarEstado();
        brazo.moverBrazo("90 grados");
        sensores.consultarEstado();
        sensores.leerTemperatura();

        System.out.println(a.finalizarComando());
        sensores.leerTemperatura();
        System.out.println(a.finalizarComando());

        a.simularFalla();
        brazo.moverBrazo("0 grados");
        a.reiniciar();

        brazo.moverBrazo("45 grados");
        a.finalizarComando();
        brazo.moverBrazo("180 grados");
        a.finalizarComando();
        sensores.leerTemperatura();
        sensores.leerTemperatura();

        a.mostrarHistorial();
    }
}

