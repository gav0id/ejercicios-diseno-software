public class Main {

    public static void main(String[] args) {
        PantallaPersonal personal = new PantallaPersonal();
        PantallaConsulta consulta = new PantallaConsulta();
        System.out.println("Mismo catalogo: " + (personal.getCatalogo() == consulta.getCatalogo()));

        consulta.mostrarCatalogo();
        personal.incorporar("M001", "Uzumaki Tomo 1", "Junji Ito", 3);
        personal.incorporar("M002", "Tokyo Ghoul Tomo 1", "Sui Ishida", 2);
        personal.incorporar("M003", "Choujin X Tomo 1", "Sui Ishida", 4);
        personal.incorporar("M001", "Death Note Tomo 1", "Tsugumi Ohba y Takeshi Obata", 1);
        personal.actualizar("M002", 67);

        consulta.mostrarCatalogo();
        consulta.buscarPorAutor("ishida");
    }
}



