public class PantallaPersonal {

    private final CatalogoLibros catalogo;

    public PantallaPersonal() {
        catalogo = CatalogoLibros.obtenerInstancia();
    }

    public CatalogoLibros getCatalogo() {
        return catalogo;
    }

    public void incorporar(String codigo, String titulo, String autor, int ejemplares) {
        System.out.println("Personal -> " + catalogo.agregar(codigo, titulo, autor, ejemplares));
    }

    public void actualizar(String codigo, int ejemplares) {
        System.out.println("Personal -> " + catalogo.actualizarEjemplares(codigo, ejemplares));
    }
}

