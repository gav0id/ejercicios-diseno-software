public class PantallaConsulta {

    private final CatalogoLibros catalogo;

    public PantallaConsulta() {
        catalogo = CatalogoLibros.obtenerInstancia();
    }

    public CatalogoLibros getCatalogo() {
        return catalogo;
    }

    public void mostrarCatalogo() {
        Libro[] todos = catalogo.obtenerTodos();
        if (todos.length == 0) {
            System.out.println("Consulta -> catalogo vacio");
            return;
        }
        System.out.println("Consulta -> catalogo (" + todos.length + " libros):");
        for (Libro libro : todos) {
            System.out.println("  " + libro);
        }
    }

    public void buscarPorTitulo(String texto) {
        mostrarResultados("titulo", texto, catalogo.buscarPorTitulo(texto));
    }

    public void buscarPorAutor(String texto) {
        mostrarResultados("autor", texto, catalogo.buscarPorAutor(texto));
    }

    private void mostrarResultados(String campo, String texto, Libro[] resultados) {
        System.out.println("Consulta -> " + campo + " '" + texto + "': " + resultados.length + " resultado(s)");
        for (Libro libro : resultados) {
            System.out.println("  " + libro);
        }
    }
}

