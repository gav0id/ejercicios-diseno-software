public class CatalogoLibros {

    private static CatalogoLibros instancia;

    private Libro[] libros;
    private int cantidad;

    private CatalogoLibros() {
        libros = new Libro[3];
        cantidad = 0;
    }

    public static CatalogoLibros obtenerInstancia() {
        if (instancia == null) {
            instancia = new CatalogoLibros();
        }
        return instancia;
    }

    private boolean estaVacio(String texto) {
        return texto == null || texto.trim().isEmpty();
    }

    private int buscarPosicion(String codigo) {
        for (int i = 0; i < cantidad; i++) {
            if (libros[i].getCodigo().equals(codigo)) {
                return i;
            }
        }
        return -1;
    }

    private void agrandar() {
        Libro[] nuevo = new Libro[libros.length * 2];
        for (int i = 0; i < cantidad; i++) {
            nuevo[i] = libros[i];
        }
        libros = nuevo;
    }

    public String agregar(String codigo, String titulo, String autor, int ejemplares) {
        if (estaVacio(codigo)) {
            return "RECHAZADO: codigo vacio";
        }
        if (estaVacio(titulo)) {
            return "RECHAZADO: titulo vacio";
        }
        if (estaVacio(autor)) {
            return "RECHAZADO: autor vacio";
        }
        if (ejemplares < 0) {
            return "RECHAZADO: cantidad negativa";
        }
        if (buscarPosicion(codigo.trim()) != -1) {
            return "RECHAZADO: codigo duplicado (" + codigo.trim() + ")";
        }
        if (cantidad == libros.length) {
            agrandar();
        }
        libros[cantidad] = new Libro(codigo.trim(), titulo.trim(), autor.trim(), ejemplares);
        cantidad++;
        return "AGREGADO: " + titulo.trim();
    }

    public String actualizarEjemplares(String codigo, int nuevos) {
        if (nuevos < 0) {
            return "RECHAZADO: cantidad negativa";
        }
        int posicion = estaVacio(codigo) ? -1 : buscarPosicion(codigo.trim());
        if (posicion == -1) {
            return "RECHAZADO: codigo inexistente (" + codigo + ")";
        }
        libros[posicion] = libros[posicion].conEjemplares(nuevos);
        return "ACTUALIZADO: " + libros[posicion].getTitulo() + " ahora tiene " + nuevos + " ejemplares";
    }

    private boolean coincide(Libro libro, String buscado, boolean porTitulo) {
        String campo = porTitulo ? libro.getTitulo() : libro.getAutor();
        return campo.toLowerCase().contains(buscado);
    }

    private Libro[] buscar(String texto, boolean porTitulo) {
        if (estaVacio(texto)) {
            return new Libro[0];
        }
        String buscado = texto.trim().toLowerCase();
        int coincidencias = 0;
        for (int i = 0; i < cantidad; i++) {
            if (coincide(libros[i], buscado, porTitulo)) {
                coincidencias++;
            }
        }
        Libro[] resultado = new Libro[coincidencias];
        int posicion = 0;
        for (int i = 0; i < cantidad; i++) {
            if (coincide(libros[i], buscado, porTitulo)) {
                resultado[posicion] = libros[i];
                posicion++;
            }
        }
        return resultado;
    }

    public Libro[] buscarPorTitulo(String texto) {
        return buscar(texto, true);
    }

    public Libro[] buscarPorAutor(String texto) {
        return buscar(texto, false);
    }

    public int cantidadLibros() {
        return cantidad;
    }

    public Libro[] obtenerTodos() {
        Libro[] copia = new Libro[cantidad];
        for (int i = 0; i < cantidad; i++) {
            copia[i] = libros[i];
        }
        return copia;
    }
}

//-----

public final class Libro {

    private final String codigo;
    private final String titulo;
    private final String autor;
    private final int ejemplares;

    public Libro(String codigo, String titulo, String autor, int ejemplares) {
        this.codigo = codigo;
        this.titulo = titulo;
        this.autor = autor;
        this.ejemplares = ejemplares;
    }

    public String getCodigo() {
        return codigo;
    }

    public String getTitulo() {
        return titulo;
    }

    public String getAutor() {
        return autor;
    }

    public int getEjemplares() {
        return ejemplares;
    }

    public Libro conEjemplares(int nuevosEjemplares) {
        return new Libro(codigo, titulo, autor, nuevosEjemplares);
    }

    @Override
    public String toString() {
        return String.format("%s | %s | %s | ejemplares: %d", codigo, titulo, autor, ejemplares);
    }
}

