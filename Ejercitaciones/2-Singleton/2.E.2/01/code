public class Main {

    public static void main(String[] args) {
        ModuloPrestamos prestamos = new ModuloPrestamos();
        ModuloConsultas consultas = new ModuloConsultas();

        System.out.println("Mismo objeto: " + (prestamos.getConfiguracion() == consultas.getConfiguracion()));

        prestamos.modificarPlazo(21);
        consultas.modificarNombre("Biblioteca Popular");
        consultas.modificarNombre("   ");

        prestamos.mostrarReglas();
        consultas.mostrarInfo();
        prestamos.getConfiguracion().mostrarHistorial();
    }
}
