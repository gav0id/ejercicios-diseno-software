public class ModuloConsultas {

    private final ConfiguracionBiblioteca config;

    public ModuloConsultas() {
        config = ConfiguracionBiblioteca.obtenerInstancia();
    }

    public ConfiguracionBiblioteca getConfiguracion() {
        return config;
    }

    public void modificarNombre(String nombre) {
        if (config.setNombre(nombre)) {
            System.out.println("Consultas -> nombre actualizado a " + config.getNombre());
        } else {
            System.out.println("Consultas -> nombre rechazado (vacio)");
        }
    }

    public void mostrarInfo() {
        System.out.println("Consultas -> " + config.getNombre() + ": maximo "
                + config.getMaxLibrosPorSocio() + " libros por socio, devolucion en "
                + config.getPlazoDevolucionDias() + " dias");
    }
}

