import java.time.LocalDate;

public class RegistroInsumos {

    private static RegistroInsumos instancia;
    private Movimiento[] movimientos = new Movimiento[4];
    private int cantidad = 0;

    private RegistroInsumos() {}

    public static RegistroInsumos obtenerInstancia() {
        if (instancia == null) {
            instancia = new RegistroInsumos();
        }
        return instancia;
    }

    public boolean registrar(String codigoInsumo, TipoMovimiento tipo, int monto, String sector, LocalDate fecha) {
        if (codigoInsumo == null || codigoInsumo.isBlank() || tipo == null
                || monto <= 0 || sector == null || sector.isBlank() || fecha == null) {
            return false;
        }
        String codigo = codigoInsumo.trim();
        if (tipo == TipoMovimiento.SALIDA && monto > calcularSaldo(codigo)) {
            return false;
        }
        if (cantidad == movimientos.length) {
            Movimiento[] nuevo = new Movimiento[movimientos.length * 2];
            for (int i = 0; i < cantidad; i++) nuevo[i] = movimientos[i];
            movimientos = nuevo;
        }
        movimientos[cantidad++] = new Movimiento(codigo, tipo, monto, sector.trim(), fecha);
        return true;
    }

    public int calcularSaldo(String codigoInsumo) {
        int saldo = 0;
        for (int i = 0; i < cantidad; i++) {
            if (movimientos[i].getCodigoInsumo().equalsIgnoreCase(codigoInsumo)) {
                saldo += (movimientos[i].getTipo() == TipoMovimiento.ENTRADA)
                        ? movimientos[i].getCantidad()
                        : -movimientos[i].getCantidad();
            }
        }
        return saldo;
    }

    public Movimiento[] obtenerHistorial() {
        Movimiento[] copia = new Movimiento[cantidad];
        for (int i = 0; i < cantidad; i++) copia[i] = movimientos[i];
        return copia;
    }

    public Movimiento[] filtrar(String codigoInsumo, String sector) {
        int total = 0;
        for (int i = 0; i < cantidad; i++) {
            if (coincide(movimientos[i], codigoInsumo, sector)) total++;
        }
        Movimiento[] resultado = new Movimiento[total];
        int pos = 0;
        for (int i = 0; i < cantidad; i++) {
            if (coincide(movimientos[i], codigoInsumo, sector)) resultado[pos++] = movimientos[i];
        }
        return resultado;
    }

    private boolean coincide(Movimiento m, String codigo, String sector) {
        boolean okCodigo = (codigo == null || codigo.isBlank() || m.getCodigoInsumo().equalsIgnoreCase(codigo));
        boolean okSector = (sector == null || sector.isBlank() || m.getSector().equalsIgnoreCase(sector));
        return okCodigo && okSector;
    }
}

//-----

public enum TipoMovimiento { ENTRADA, SALIDA }

//-----

import java.time.LocalDate;

public final class Movimiento {

    private final String codigoInsumo;
    private final TipoMovimiento tipo;
    private final int cantidad;
    private final String sector;
    private final LocalDate fecha;

    Movimiento(String codigoInsumo, TipoMovimiento tipo, int cantidad, String sector, LocalDate fecha) {
        this.codigoInsumo = codigoInsumo;
        this.tipo = tipo;
        this.cantidad = cantidad;
        this.sector = sector;
        this.fecha = fecha;
    }

    public String getCodigoInsumo() { return codigoInsumo; }
    public TipoMovimiento getTipo() { return tipo; }
    public int getCantidad() { return cantidad; }
    public String getSector() { return sector; }
    public LocalDate getFecha() { return fecha; }

    @Override
    public String toString() {
        return fecha + " - " + sector + " - " + tipo + " - " + codigoInsumo + " (" + cantidad + ")";
    }
}

