import java.time.LocalDate;

public class SectorHospital {

    private final String nombre;
    private final RegistroInsumos registro;

    public SectorHospital(String nombre) {
        this.nombre = nombre;
        this.registro = RegistroInsumos.obtenerInstancia();
    }

    public RegistroInsumos getRegistro() { return registro; }

    public boolean registrar(String codigoInsumo, TipoMovimiento tipo, int cantidad, LocalDate fecha) {
        return registro.registrar(codigoInsumo, tipo, cantidad, nombre, fecha);
    }
}

