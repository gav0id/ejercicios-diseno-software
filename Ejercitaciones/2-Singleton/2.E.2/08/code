import java.time.LocalDate;

public class Main {
    public static void main(String[] args) {
        SectorHospital deposito = new SectorHospital("Deposito");
        SectorHospital consultorios = new SectorHospital("Consultorios");
        SectorHospital laboratorio = new SectorHospital("Laboratorio");

        boolean mismaInstancia = deposito.getRegistro() == consultorios.getRegistro()
                && consultorios.getRegistro() == laboratorio.getRegistro();
        System.out.println("Misma instancia en los 3 sectores: " + mismaInstancia);

        LocalDate hoy = LocalDate.of(2026, 11, 25);
        System.out.println("Entrada inicial INS-67: " + deposito.registrar("INS-67", TipoMovimiento.ENTRADA, 50, hoy));
        System.out.println("Salida Consultorios (20): " + consultorios.registrar("INS-67", TipoMovimiento.SALIDA, 20, hoy));
        System.out.println("Salida Laboratorio (40 - excede saldo): " + laboratorio.registrar("INS-67", TipoMovimiento.SALIDA, 40, hoy));
        System.out.println("Cantidad invalida (-5): " + deposito.registrar("INS-67", TipoMovimiento.ENTRADA, -5, hoy));
        System.out.println("Salida Laboratorio (10): " + laboratorio.registrar("INS-67", TipoMovimiento.SALIDA, 10, hoy));

        RegistroInsumos reg = RegistroInsumos.obtenerInstancia();
        System.out.println("Saldo INS-67: " + reg.calcularSaldo("INS-67"));

        System.out.println("Historial completo:");
        for (Movimiento m : reg.obtenerHistorial()) System.out.println("  " + m);

        System.out.println("Filtro (INS-67, Laboratorio):");
        for (Movimiento m : reg.filtrar("INS-67", "Laboratorio")) System.out.println("  " + m);
    }
}
