public class Main {
    public static void main(String[] args) throws InterruptedException {
        String[] sectores = {"Recepcion", "Facturacion", "Archivo"};
        Thread[] hilos = new Thread[10];
        GestorImpresion[] refs = new GestorImpresion[10];

        for (int i = 0; i < 10; i++) {
            int h = i;
            hilos[i] = new Thread(() -> {
                refs[h] = GestorImpresion.obtenerInstancia();
                for (int j = 1; j <= 3; j++) {
                    String id = "DOC-" + (h * 3 + j);
                    refs[h].encolar(new Documento(id, "Archivo_" + id + ".pdf", sectores[h % 3], j + 1));
                }
            });
            hilos[i].start();
        }
        for (Thread t : hilos) t.join();

        GestorImpresion gestor = GestorImpresion.obtenerInstancia();
        boolean mismaInstancia = true;
        for (GestorImpresion r : refs) {
            if (r != gestor) {
                mismaInstancia = false;
                break;
            }
        }

        System.out.println("Misma instancia en los 10 hilos: " + mismaInstancia);
        gestor.procesarTodos();
        gestor.emitirInforme();
    }
}



