public final class GestorImpresion {

    private static volatile GestorImpresion instancia;
    private final Object candado = new Object();

    private Documento[] cola = new Documento[10];
    private int inicio = 0;
    private int fin = 0;

    private Documento[] procesados = new Documento[10];
    private int cantProcesados = 0;

    private GestorImpresion() {}

    public static GestorImpresion obtenerInstancia() {
        if (instancia == null) {
            synchronized (GestorImpresion.class) {
                if (instancia == null) {
                    instancia = new GestorImpresion();
                }
            }
        }
        return instancia;
    }

    private boolean existeId(String id) {
        for (int i = inicio; i < fin; i++) {
            if (cola[i].getId().equalsIgnoreCase(id)) return true;
        }
        for (int i = 0; i < cantProcesados; i++) {
            if (procesados[i].getId().equalsIgnoreCase(id)) return true;
        }
        return false;
    }

    private Documento[] agrandar(Documento[] arr, int desde, int hasta) {
        Documento[] nuevo = new Documento[arr.length * 2];
        for (int i = desde; i < hasta; i++) nuevo[i - desde] = arr[i];
        return nuevo;
    }

    public boolean encolar(Documento doc) {
        if (doc == null || doc.getId() == null || doc.getId().isBlank()) return false;
        synchronized (candado) {
            if (existeId(doc.getId())) return false;
            if (fin == cola.length) {
                cola = agrandar(cola, inicio, fin);
                fin -= inicio;
                inicio = 0;
            }
            cola[fin++] = doc;
            return true;
        }
    }

    public Documento procesarSiguiente() {
        synchronized (candado) {
            if (inicio == fin) return null;
            Documento doc = cola[inicio];
            cola[inicio++] = null;
            if (cantProcesados == procesados.length) {
                procesados = agrandar(procesados, 0, cantProcesados);
            }
            procesados[cantProcesados++] = doc;
            System.out.println("Imprimiendo - " + doc);
            return doc;
        }
    }

    public void procesarTodos() {
        while (procesarSiguiente() != null) {}
    }

    public void emitirInforme() {
        synchronized (candado) {
            System.out.println("Informe - total procesados: " + cantProcesados);
            for (int i = 0; i < cantProcesados; i++) {
                System.out.println((i + 1) + ". " + procesados[i]);
            }
        }
    }
}

