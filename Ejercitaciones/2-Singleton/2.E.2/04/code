import java.time.LocalDate;

public class MostradorSecundario {

    private final AdministradorPrestamos administrador;

    public MostradorSecundario() {
        administrador = AdministradorPrestamos.obtenerInstancia();
    }

    public AdministradorPrestamos getAdministrador() {
        return administrador;
    }

    public void prestar(String idEjemplar, String socio, LocalDate fecha) {
        System.out.println("Secundario -> " + administrador.prestar(idEjemplar, socio, fecha));
    }

    public void mostrarActivos(String socio) {
        Prestamo[] activos = administrador.prestamosActivosDe(socio);
        System.out.println("Secundario -> prestamos activos de " + socio + ": " + activos.length);
        for (Prestamo prestamo : activos) {
            System.out.println("  " + prestamo);
        }
    }
}

