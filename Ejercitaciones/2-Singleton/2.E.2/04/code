import java.time.LocalDate;

public final class Prestamo {

    private final String idEjemplar;
    private final String socio;
    private final LocalDate fecha;

    public Prestamo(String idEjemplar, String socio, LocalDate fecha) {
        this.idEjemplar = idEjemplar;
        this.socio = socio;
        this.fecha = fecha;
    }

    public String getIdEjemplar() {
        return idEjemplar;
    }

    public String getSocio() {
        return socio;
    }

    public LocalDate getFecha() {
        return fecha;
    }

    @Override
    public String toString() {
        return String.format("%s | socio: %s | fecha: %s", idEjemplar, socio, fecha);
    }
}

