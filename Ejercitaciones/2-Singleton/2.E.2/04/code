import java.time.LocalDate;

public class AdministradorPrestamos {

    private static AdministradorPrestamos instancia;

    private Prestamo[] activos;
    private int cantidad;

    private AdministradorPrestamos() {
        activos = new Prestamo[2];
        cantidad = 0;
    }

    public static AdministradorPrestamos obtenerInstancia() {
        if (instancia == null) {
            instancia = new AdministradorPrestamos();
        }
        return instancia;
    }

    private boolean estaVacio(String texto) {
        return texto == null || texto.trim().isEmpty();
    }

    private int buscarPosicion(String idEjemplar) {
        for (int i = 0; i < cantidad; i++) {
            if (activos[i].getIdEjemplar().equalsIgnoreCase(idEjemplar)) {
                return i;
            }
        }
        return -1;
    }

    private void agrandar() {
        Prestamo[] nuevo = new Prestamo[activos.length * 2];
        for (int i = 0; i < cantidad; i++) {
            nuevo[i] = activos[i];
        }
        activos = nuevo;
    }

    public String prestar(String idEjemplar, String socio, LocalDate fecha) {
        if (estaVacio(idEjemplar)) {
            return "RECHAZADO: identificador de ejemplar vacio";
        }
        if (estaVacio(socio)) {
            return "RECHAZADO: socio vacio";
        }
        if (fecha == null) {
            return "RECHAZADO: fecha nula";
        }
        String id = idEjemplar.trim();
        int posicion = buscarPosicion(id);
        if (posicion != -1) {
            return "RECHAZADO: el ejemplar " + id + " ya esta prestado a " + activos[posicion].getSocio();
        }
        if (cantidad == activos.length) {
            agrandar();
        }
        activos[cantidad] = new Prestamo(id, socio.trim(), fecha);
        cantidad++;
        return "PRESTADO: " + id + " a " + socio.trim();
    }

    public String devolver(String idEjemplar) {
        if (estaVacio(idEjemplar)) {
            return "RECHAZADO: identificador de ejemplar vacio";
        }
        String id = idEjemplar.trim();
        int posicion = buscarPosicion(id);
        if (posicion == -1) {
            return "RECHAZADO: el ejemplar " + id + " no tiene un prestamo activo";
        }
        String socio = activos[posicion].getSocio();
        for (int i = posicion + 1; i < cantidad; i++) {
            activos[i - 1] = activos[i];
        }
        cantidad--;
        activos[cantidad] = null;
        return "DEVUELTO: " + id + " (prestado a " + socio + ")";
    }

    public Prestamo[] prestamosActivosDe(String socio) {
        if (estaVacio(socio)) {
            return new Prestamo[0];
        }
        int coincidencias = 0;
        for (int i = 0; i < cantidad; i++) {
            if (activos[i].getSocio().equalsIgnoreCase(socio.trim())) {
                coincidencias++;
            }
        }
        Prestamo[] resultado = new Prestamo[coincidencias];
        int posicion = 0;
        for (int i = 0; i < cantidad; i++) {
            if (activos[i].getSocio().equalsIgnoreCase(socio.trim())) {
                resultado[posicion] = activos[i];
                posicion++;
            }
        }
        return resultado;
    }

    public int cantidadActivos() {
        return cantidad;
    }
}

