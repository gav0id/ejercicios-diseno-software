import java.time.LocalDate;
import java.time.LocalTime;

public final class AdministradorTurnos {

    private static volatile AdministradorTurnos instancia;
    private final Object candado = new Object();

    private Turno[] agenda = new Turno[4];
    private int cantidad = 0;

    private AdministradorTurnos() {}

    public static AdministradorTurnos obtenerInstancia() {
        if (instancia == null) {
            synchronized (AdministradorTurnos.class) {
                if (instancia == null) {
                    instancia = new AdministradorTurnos();
                }
            }
        }
        return instancia;
    }

    private int buscar(String profesional, LocalDate fecha, LocalTime horario) {
        for (int i = 0; i < cantidad; i++) {
            Turno t = agenda[i];
            if (t.getProfesional().equalsIgnoreCase(profesional)
                    && t.getFecha().equals(fecha)
                    && t.getHorario().equals(horario)) {
                return i;
            }
        }
        return -1;
    }

    public boolean cargarHorario(String profesional, LocalDate fecha, LocalTime horario) {
        if (profesional == null || profesional.isBlank() || fecha == null || horario == null) return false;
        synchronized (candado) {
            if (buscar(profesional.trim(), fecha, horario) != -1) return false;
            if (cantidad == agenda.length) {
                Turno[] nuevo = new Turno[agenda.length * 2];
                for (int i = 0; i < cantidad; i++) nuevo[i] = agenda[i];
                agenda = nuevo;
            }
            agenda[cantidad++] = new Turno(profesional.trim(), fecha, horario, null);
            return true;
        }
    }

    public boolean reservar(String paciente, String profesional, LocalDate fecha, LocalTime horario) {
        if (paciente == null || paciente.isBlank()) return false;
        synchronized (candado) {
            int pos = buscar(profesional, fecha, horario);
            if (pos == -1 || !agenda[pos].estaLibre()) return false;
            agenda[pos] = agenda[pos].conPaciente(paciente.trim());
            return true;
        }
    }

    public boolean cancelar(String profesional, LocalDate fecha, LocalTime horario) {
        synchronized (candado) {
            int pos = buscar(profesional, fecha, horario);
            if (pos == -1 || agenda[pos].estaLibre()) return false;
            agenda[pos] = agenda[pos].conPaciente(null);
            return true;
        }
    }

    public Turno[] consultarAgenda() {
        synchronized (candado) {
            Turno[] copia = new Turno[cantidad];
            for (int i = 0; i < cantidad; i++) copia[i] = agenda[i];
            return copia;
        }
    }
}

