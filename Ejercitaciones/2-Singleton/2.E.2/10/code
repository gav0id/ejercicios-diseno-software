import java.time.LocalDate;
import java.time.LocalTime;

public class PuestoTurnos {

    private final String nombre;
    private final AdministradorTurnos admin;

    public PuestoTurnos(String nombre) {
        this.nombre = nombre;
        this.admin = AdministradorTurnos.obtenerInstancia();
    }

    public AdministradorTurnos getAdmin() { return admin; }

    public boolean reservar(String paciente, String profesional, LocalDate fecha, LocalTime horario) {
        return admin.reservar(paciente, profesional, fecha, horario);
    }

    public boolean cancelar(String profesional, LocalDate fecha, LocalTime horario) {
        return admin.cancelar(profesional, fecha, horario);
    }

    public void mostrarAgenda() {
        System.out.println(nombre + " - agenda:");
        for (Turno t : admin.consultarAgenda()) System.out.println("  " + t);
    }
}

