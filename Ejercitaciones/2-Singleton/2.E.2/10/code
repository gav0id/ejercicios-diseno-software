import java.time.LocalDate;
import java.time.LocalTime;

public final class Turno {

    private final String profesional;
    private final LocalDate fecha;
    private final LocalTime horario;
    private final String paciente;

    public Turno(String profesional, LocalDate fecha, LocalTime horario, String paciente) {
        this.profesional = profesional;
        this.fecha = fecha;
        this.horario = horario;
        this.paciente = paciente;
    }

    public String getProfesional() { return profesional; }
    public LocalDate getFecha() { return fecha; }
    public LocalTime getHorario() { return horario; }
    public String getPaciente() { return paciente; }
    public boolean estaLibre() { return paciente == null; }

    public Turno conPaciente(String nuevoPaciente) {
        return new Turno(profesional, fecha, horario, nuevoPaciente);
    }

    @Override
    public String toString() {
        String estado = estaLibre() ? "DISPONIBLE" : "OCUPADO (" + paciente + ")";
        return profesional + " - " + fecha + " " + horario + " - " + estado;
    }
}

