import java.time.LocalDate;
import java.time.LocalTime;

public class Main {
    public static void main(String[] args) throws InterruptedException {
        PuestoTurnos recepcion = new PuestoTurnos("Recepcion");
        PuestoTurnos autoservicio = new PuestoTurnos("Autoservicio");
        System.out.println("Misma instancia: " + (recepcion.getAdmin() == autoservicio.getAdmin()));

        LocalDate hoy = LocalDate.of(2026, 11, 25);
        LocalTime hora = LocalTime.of(10, 0);
        recepcion.getAdmin().cargarHorario("Dra. Tenma", hoy, hora);
        recepcion.getAdmin().cargarHorario("Dra. Tenma", hoy, LocalTime.of(10, 30));

        Thread[] hilos = new Thread[20];
        boolean[] resultados = new boolean[20];
        for (int i = 0; i < 20; i++) {
            int n = i;
            PuestoTurnos puesto = (n % 2 == 0) ? recepcion : autoservicio;
            hilos[i] = new Thread(() -> resultados[n] = puesto.reservar("Paciente-" + (n + 1), "Dra. Tenma", hoy, hora));
            hilos[i].start();
        }
        for (Thread h : hilos) h.join();

        int exitosos = 0;
        for (boolean ok : resultados) if (ok) exitosos++;
        System.out.println("Exitosos sobre 20 solicitudes: " + exitosos);

        recepcion.mostrarAgenda();
        System.out.println("Cancelar inexistente: " + autoservicio.cancelar("Dra. Tenma", hoy, LocalTime.of(15, 0)));
        System.out.println("Cancelar existente: " + recepcion.cancelar("Dra. Tenma", hoy, hora));
        autoservicio.mostrarAgenda();
    }
}




