public class Main {

    public static void main(String[] args) {
        RegistroActividades a = RegistroActividades.obtenerInstancia();
        RegistroActividades b = RegistroActividades.obtenerInstancia();
        System.out.println("Misma instancia: " + (a == b));

        SectorPrestamos prestamos = new SectorPrestamos();
        SectorDevoluciones devoluciones = new SectorDevoluciones();
        SectorAtencionSocios atencion = new SectorAtencionSocios();

        prestamos.prestar("Ana", "Another");
        devoluciones.devolver("Luis", "Adabana");
        atencion.atender("Marta", "Flores del Mal");
        prestamos.prestar("Luis", "Rastros de Sangre");
        devoluciones.devolver("Ana", "Another");

        System.out.println("Total de eventos: " + a.cantidadEventos());
        for (Actividad act : a.obtenerHistorial()) {
            System.out.println(act);
        }
        System.out.println("Solo Prestamos");
        for (Actividad act : a.filtrarPorSector("Prestamos")) {
            System.out.println(act);
        }
    }
}
