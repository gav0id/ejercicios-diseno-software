public class Main {
    public static void main(String[] args) {
        GestorTelemetria gestor = new GestorTelemetria();
        gestor.registrarFabrica("MQTT", new CreadorMQTT("ssl://broker.pharloom.io:8883"));
        gestor.registrarFabrica("HTTP", new CreadorHTTP("https://api.deepdocks.local/v1"));
        gestor.registrarFabrica("CoAP", new CreadorCoAP("coap://greymoor.local/sensores"));

        gestor.registrarFabrica("MODBUS", new CreadorConectorIoT() {
            @Override
            public ConectorIoT crearConector(String cred) {
                if (cred == null || cred.isBlank()) {
                    throw new IllegalArgumentException("Modbus - sin credencial");
                }
                return new ConectorIoT() {
                    @Override
                    public void conectar(String c) {
                        System.out.println("MODBUS - conectado con " + c);
                    }

                    @Override
                    public String leerTelemetria() {
                        return "MODBUS - registro 67 = 420";
                    }
                };
            }
        });

        String[] protos = {"MQTT", "HTTP", "COAP", "MQTT", "MODBUS"};
        String[] creds = {"tok-67-miku", "key-67-luka", "cred-67-teto", "", "mod-67"};

        for (int i = 0; i < protos.length; i++) {
            ConectorIoT c = gestor.inicializarCanal(protos[i], creds[i]);
            if (c != null) {
                System.out.println("Lectura - " + c.leerTelemetria());
            }
        }
        gestor.mostrarMetricas();
    }
}
