import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.AtomicInteger;

public class GestorTelemetria {
    private final ConcurrentHashMap<String, CreadorConectorIoT> fabricas = new ConcurrentHashMap<>();
    private final ConcurrentHashMap<String, AtomicInteger> metricasExito = new ConcurrentHashMap<>();
    private final ConcurrentHashMap<String, AtomicInteger> metricasFallo = new ConcurrentHashMap<>();

    public void registrarFabrica(String protocolo, CreadorConectorIoT creador) {
        fabricas.put(protocolo.toUpperCase(), creador);
        metricasExito.putIfAbsent(protocolo.toUpperCase(), new AtomicInteger(0));
        metricasFallo.putIfAbsent(protocolo.toUpperCase(), new AtomicInteger(0));
    }

    public ConectorIoT inicializarCanal(String protocolo, String credencial) {
        String key = protocolo.toUpperCase();
        CreadorConectorIoT creador = fabricas.get(key);
        if (creador == null) {
            metricasFallo.computeIfAbsent(key, k -> new AtomicInteger(0)).incrementAndGet();
            return null;
        }
        try {
            ConectorIoT conector = creador.crearConector(credencial);
            metricasExito.get(key).incrementAndGet();
            return conector;
        } catch (Exception e) {
            metricasFallo.get(key).incrementAndGet();
            System.out.println("Fallo inicializando " + key + " - " + e.getMessage());
            return null;
        }
    }

    public void mostrarMetricas() {
        for (String key : fabricas.keySet()) {
            System.out.println("Metrica " + key + " - ok: " + metricasExito.get(key).get()
                    + " - fallos: " + metricasFallo.get(key).get());
        }
    }
}

