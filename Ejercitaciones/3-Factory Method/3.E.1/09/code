public abstract class CreadorConectorIoT {
    public abstract ConectorIoT crearConector(String credencial) throws Exception;
}

//-----

public class CreadorMQTT extends CreadorConectorIoT {
    private final String broker;

    public CreadorMQTT(String broker) {
        this.broker = broker;
    }

    @Override
    public ConectorIoT crearConector(String credencial) {
        if (credencial == null || credencial.isBlank()) {
            throw new IllegalArgumentException("MQTT - credencial invalida");
        }
        if (broker == null || !broker.startsWith("ssl://")) {
            throw new IllegalStateException("MQTT - se requiere broker seguro ssl://");
        }
        ConectorMQTT c = new ConectorMQTT(broker);
        c.conectar(credencial);
        return c;
    }
}

//-----

public class CreadorHTTP extends CreadorConectorIoT {
    private final String endpoint;

    public CreadorHTTP(String endpoint) {
        this.endpoint = endpoint;
    }

    @Override
    public ConectorIoT crearConector(String credencial) {
        if (credencial == null || credencial.length() < 6) {
            throw new IllegalArgumentException("HTTP - API key muy corta");
        }
        ConectorHTTP c = new ConectorHTTP(endpoint);
        c.conectar(credencial);
        return c;
    }
}

//-----

public class CreadorCoAP extends CreadorConectorIoT {
    private final String uri;

    public CreadorCoAP(String uri) {
        this.uri = uri;
    }

    @Override
    public ConectorIoT crearConector(String credencial) {
        if (credencial == null || credencial.isBlank()) {
            throw new IllegalArgumentException("CoAP - credencial requerida");
        }
        ConectorCoAP c = new ConectorCoAP(uri);
        c.conectar(credencial);
        return c;
    }
}

