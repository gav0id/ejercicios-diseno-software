public interface ExportadorReporte {
    boolean validar(String[] encabezados, String[][] filas);
    String exportar(String[] encabezados, String[][] filas);
}

//-----

public class ExportadorPDF implements ExportadorReporte {

    @Override
    public boolean validar(String[] encabezados, String[][] filas) {
        for (String[] fila : filas) {
            if (fila == null || fila.length != encabezados.length) return false;
        }
        return true;
    }

    @Override
    public String exportar(String[] encabezados, String[][] filas) {
        StringBuilder sb = new StringBuilder("[PDF] " + String.join(" | ", encabezados) + "\n");
        for (String[] fila : filas) {
            sb.append("  ").append(String.join(" | ", fila)).append("\n");
        }
        return sb.toString().trim();
    }
}

//-----

public class ExportadorCSV implements ExportadorReporte {

    @Override
    public boolean validar(String[] encabezados, String[][] filas) {
        for (String[] fila : filas) {
            if (fila == null || fila.length != encabezados.length) return false;
            for (String celda : fila) {
                if (celda == null || celda.contains(",")) return false;
            }
        }
        return true;
    }

    @Override
    public String exportar(String[] encabezados, String[][] filas) {
        StringBuilder sb = new StringBuilder("[CSV]\n" + String.join(",", encabezados) + "\n");
        for (String[] fila : filas) {
            sb.append(String.join(",", fila)).append("\n");
        }
        return sb.toString().trim();
    }
}

//-----

public abstract class CreadorExportador {

    public abstract ExportadorReporte crearExportador();

    public String generarReporte(String[] encabezados, String[][] filas) {
        if (encabezados == null || encabezados.length == 0 || filas == null || filas.length == 0) {
            return "RECHAZADO - reporte sin datos";
        }
        ExportadorReporte exportador = crearExportador();
        if (!exportador.validar(encabezados, filas)) {
            return "RECHAZADO - formato de datos invalido";
        }
        return exportador.exportar(encabezados, filas);
    }
}

//-----

public class CreadorPDF extends CreadorExportador {
    @Override
    public ExportadorReporte crearExportador() {
        return new ExportadorPDF();
    }
}

//-----

public class CreadorCSV extends CreadorExportador {
    @Override
    public ExportadorReporte crearExportador() {
        return new ExportadorCSV();
    }
}

//-----

public class Main {
    public static void main(String[] args) {
        String[] encabezados = {"Concepto", "Monto"};
        String[][] filasValidas = {
            {"Uzumaki Tomo 1", "6700.00"},
            {"Fatal Frame", "146999.00"}
        };
        String[][] filasInvalidas = {
            {"Ramen, Pepsi", "670.00"}
        };

        CreadorExportador[] creadores = { new CreadorPDF(), new CreadorCSV() };

        for (CreadorExportador c : creadores) {
            System.out.println(c.generarReporte(encabezados, filasValidas));
        }
        System.out.println("CSV con coma - " + creadores[1].generarReporte(encabezados, filasInvalidas));
        System.out.println("Reporte vacio - " + creadores[0].generarReporte(encabezados, new String[0][0]));
    }
}
