public interface EmisorNotarial {
    TituloPropiedad emitir(String jurisdiccion, String dniTitular, String matricula);
}

//-----

public record TituloPropiedad(
    String jurisdiccion,
    String dniTitular,
    String matriculaCatastral,
    String codigoNotarial,
    String firmaDigital,
    String documento
) {}

//-----

import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.util.HexFormat;

public final class EmisorMendoza implements EmisorNotarial {

    @Override
    public TituloPropiedad emitir(String jurisdiccion, String dniTitular, String matricula) {
        if (dniTitular == null || !dniTitular.matches("\\d{8}")) {
            throw new IllegalArgumentException("MZA - DNI invalido (requiere 8 digitos)");
        }
        if (matricula == null || !matricula.matches("MZA-\\d{4}")) {
            throw new IllegalArgumentException("MZA - matricula invalida (formato MZA-0000)");
        }
        String codigo = "NOT-MZA-" + Math.abs((dniTitular + matricula).hashCode());
        String firma = firmar(jurisdiccion + "|" + dniTitular + "|" + matricula + "|" + codigo);
        String doc = "[TITULO MZA] DNI: " + dniTitular + " - Matricula: " + matricula
                + " - Codigo: " + codigo + " - Firma: " + firma;
        return new TituloPropiedad(jurisdiccion, dniTitular, matricula, codigo, firma, doc);
    }

    private String firmar(String datos) {
        try {
            byte[] hash = MessageDigest.getInstance("SHA-256").digest(datos.getBytes(StandardCharsets.UTF_8));
            return HexFormat.of().formatHex(hash).substring(0, 16).toUpperCase();
        } catch (Exception e) {
            throw new IllegalStateException("Error de firma digital", e);
        }
    }
}

