import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.AtomicInteger;

public class GestorSensores {
    private final ConcurrentHashMap<String, CreadorSensor> fabricas = new ConcurrentHashMap<>();
    private final ConcurrentHashMap<String, AtomicInteger> metricasOk = new ConcurrentHashMap<>();
    private final ConcurrentHashMap<String, AtomicInteger> metricasFallo = new ConcurrentHashMap<>();

    public void registrarFabrica(String protocolo, CreadorSensor creador) {
        String key = protocolo.toUpperCase();
        fabricas.put(key, creador);
        metricasOk.putIfAbsent(key, new AtomicInteger(0));
        metricasFallo.putIfAbsent(key, new AtomicInteger(0));
    }

    public SensorAmbiental inicializarSensor(String protocolo, String direccionMemoria) {
        String key = protocolo.toUpperCase();
        CreadorSensor creador = fabricas.get(key);
        if (creador == null) {
            metricasFallo.computeIfAbsent(key, k -> new AtomicInteger(0)).incrementAndGet();
            return null;
        }
        try {
            SensorAmbiental sensor = creador.crearSensor(direccionMemoria);
            metricasOk.get(key).incrementAndGet();
            return sensor;
        } catch (Exception e) {
            metricasFallo.get(key).incrementAndGet();
            System.out.println("Fallo inicializando " + key + " - " + e.getMessage());
            return null;
        }
    }

    public void mostrarMetricas() {
        for (String key : fabricas.keySet()) {
            System.out.println("Metrica " + key + " - ok: " + metricasOk.get(key).get()
                    + " - fallos: " + metricasFallo.get(key).get());
        }
    }
}

//-----

public class Main {
    public static void main(String[] args) {
        GestorSensores gestor = new GestorSensores();
        gestor.registrarFabrica("MODBUS", new CreadorModBus("COM4"));
        gestor.registrarFabrica("I2C", new CreadorI2C("i2c-1"));
        gestor.registrarFabrica("SPI", new CreadorSPI("CS0"));

        gestor.registrarFabrica("UART", new CreadorSensor() {
            @Override
            public SensorAmbiental crearSensor(String dir) {
                if (dir == null || dir.isBlank()) {
                    throw new IllegalArgumentException("UART - direccion requerida");
                }
                SensorAmbiental s = new SensorAmbiental() {
                    @Override
                    public void inicializar(String d) {
                        System.out.println("UART (/dev/ttyS0) - inicializado en " + d);
                    }

                    @Override
                    public String leerDatos() {
                        return "UART [/dev/ttyS0] - CO2 415ppm";
                    }
                };
                s.inicializar(dir);
                return s;
            }
        });

        String[] protos = {"MODBUS", "I2C", "SPI", "I2C", "UART"};
        String[] direcciones = {"0x0100", "0x76", "0x20", "INVALIDA", "0x10"};

        for (int i = 0; i < protos.length; i++) {
            SensorAmbiental s = gestor.inicializarSensor(protos[i], direcciones[i]);
            if (s != null) {
                System.out.println("Lectura - " + s.leerDatos());
            }
        }
        gestor.mostrarMetricas();
    }
}
