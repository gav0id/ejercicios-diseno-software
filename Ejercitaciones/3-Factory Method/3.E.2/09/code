public interface SensorAmbiental {
    void inicializar(String direccionMemoria);
    String leerDatos();
}

//-----

public class SensorModBus implements SensorAmbiental {
    private final String puerto;

    public SensorModBus(String puerto) {
        this.puerto = puerto;
    }

    @Override
    public void inicializar(String direccionMemoria) {
        System.out.println("ModBus (" + puerto + ") - inicializado en registro " + direccionMemoria);
    }

    @Override
    public String leerDatos() {
        return "ModBus [" + puerto + "] - temperatura 24.6C";
    }
}

