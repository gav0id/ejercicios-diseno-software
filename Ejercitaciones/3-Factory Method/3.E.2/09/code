//-----

public abstract class CreadorSensor {
    public abstract SensorAmbiental crearSensor(String direccionMemoria) throws Exception;
}

//-----

public class CreadorModBus extends CreadorSensor {
    private final String puerto;

    public CreadorModBus(String puerto) {
        this.puerto = puerto;
    }

    @Override
    public SensorAmbiental crearSensor(String direccionMemoria) {
        if (puerto == null || !puerto.startsWith("COM")) {
            throw new IllegalStateException("ModBus - puerto serial invalido: " + puerto);
        }
        if (direccionMemoria == null || !direccionMemoria.matches("0x[0-9A-Fa-f]{4}")) {
            throw new IllegalArgumentException("ModBus - direccion de registro invalida: " + direccionMemoria);
        }
        SensorModBus s = new SensorModBus(puerto);
        s.inicializar(direccionMemoria);
        return s;
    }
}

//-----

public class CreadorI2C extends CreadorSensor {
    private final String bus;

    public CreadorI2C(String bus) {
        this.bus = bus;
    }

    @Override
    public SensorAmbiental crearSensor(String direccionMemoria) {
        if (bus == null || bus.isBlank()) {
            throw new IllegalStateException("I2C - bus no configurado");
        }
        if (direccionMemoria == null || !direccionMemoria.matches("0x[0-9A-Fa-f]{2}")) {
            throw new IllegalArgumentException("I2C - direccion de 7 bits invalida: " + direccionMemoria);
        }
        SensorI2C s = new SensorI2C(bus);
        s.inicializar(direccionMemoria);
        return s;
    }
}

//-----

public class CreadorSPI extends CreadorSensor {
    private final String canalCS;

    public CreadorSPI(String canalCS) {
        this.canalCS = canalCS;
    }

    @Override
    public SensorAmbiental crearSensor(String direccionMemoria) {
        if (canalCS == null || !canalCS.startsWith("CS")) {
            throw new IllegalStateException("SPI - linea Chip Select invalida: " + canalCS);
        }
        if (direccionMemoria == null || direccionMemoria.isBlank()) {
            throw new IllegalArgumentException("SPI - direccion de memoria requerida");
        }
        SensorSPI s = new SensorSPI(canalCS);
        s.inicializar(direccionMemoria);
        return s;
    }
}

