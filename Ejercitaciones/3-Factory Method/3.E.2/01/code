public interface PerfilUsuario {
    String getRol();
    String getPermisos();
}

//-----

public class PerfilEstudiante implements PerfilUsuario {
    @Override
    public String getRol() { return "Estudiante"; }

    @Override
    public String getPermisos() { return "Leer apuntes, comentar, entregar tareas"; }
}

//-----

public class PerfilDocente implements PerfilUsuario {
    @Override
    public String getRol() { return "Docente"; }

    @Override
    public String getPermisos() { return "Publicar material, crear evaluaciones, calificar"; }
}

//-----

public abstract class CreadorPerfil {

    public abstract PerfilUsuario crearPerfil();

    public void registrarUsuario(String nombre) {
        PerfilUsuario perfil = crearPerfil();
        System.out.println("Registro - " + nombre + " - Rol: " + perfil.getRol() + " - Permisos: " + perfil.getPermisos());
    }
}

//-----

public class CreadorEstudiante extends CreadorPerfil {
    @Override
    public PerfilUsuario crearPerfil() { return new PerfilEstudiante(); }
}

//-----

public class CreadorDocente extends CreadorPerfil {
    @Override
    public PerfilUsuario crearPerfil() { return new PerfilDocente(); }
}

//-----

public class Main {
    public static void main(String[] args) {
        CreadorPerfil[] creadores = { new CreadorEstudiante(), new CreadorDocente() };
        String[] usuarios = { "Benito", "Lucia" };

        for (int i = 0; i < creadores.length; i++) {
            creadores[i].registrarUsuario(usuarios[i]);
        }
    }
}

